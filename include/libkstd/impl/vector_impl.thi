#pragma once
#include <libkrt/krt.hpp>

namespace KernelSTD {
    template<typename Type>
    Vector<Type>::Vector(size_t size) {
        resize(size);
    }

    template<typename Type>
    Vector<Type>::Vector(const Type& data, size_t size) {
        resize(size);

        buffSize = size;

        for (size_t i = 0; i < buffSize; i++) buffer[i] = data;
    }

    template<typename Type>
    Vector<Type>::Vector(std::initializer_list<Type> list) {
        insert(begin(), list.begin(), list.end());
    }

    template<typename Type>
    Vector<Type>::Vector(const Vector& obj) {
        copy(obj);
    }

    template<typename Type>
    Vector<Type>::Vector(Vector&& obj) {
        swap(obj);
    }

    template<typename Type>
    Vector<Type>& Vector<Type>::operator=(std::initializer_list<Type> list) {
        clear();

        insert(begin(), list.begin(), list.end());
    }

    template<typename Type>
    Vector<Type>& Vector<Type>::operator=(const Vector& obj) {
        copy(obj);

        return *this;
    }

    template<typename Type>
    Vector<Type>& Vector<Type>::operator=(Vector&& obj) {
        swap(obj);

        return *this;
    }

    template<typename Type>
    void Vector<Type>::copy(const Vector& obj) {
        clear();

        insert(begin(), obj.begin(), obj.end());
    }

    template<typename Type>
    void Vector<Type>::swap(Vector& obj) {
        std::swap(buffCapacity, obj.buffCapacity);
        std::swap(buffSize, obj.buffSize);
        std::swap(buffer, obj.buffer);
    }

    template<typename Type>
    void Vector<Type>::resize(size_t size) {
        std::unique_ptr<Type[]> newbuffer{new Type[size]};

        std::copy(buffer.get(), buffer.get() + std::min(buffSize, size), newbuffer.get());

        buffCapacity = size;
        buffer = std::move(newbuffer);
    }

    template<typename Type>
    size_t Vector<Type>::capacity() const {
        return buffCapacity;
    }

    template<typename Type>
    size_t Vector<Type>::size() const {
        return buffSize;
    }

    template<typename Type>
    Type& Vector<Type>::operator[](size_t index) {
        return buffer[index];
    }

    template<typename Type>
    Type& Vector<Type>::at(size_t index) {
        if (index >= buffSize) KernelRT::abort();

        return buffer[index];
    }

    template<typename Type>
    void Vector<Type>::insert(size_t pos, const Type& value) {
        insert(pos, value, 1);
    }

    template<typename Type>
    void Vector<Type>::insert(size_t pos, const Type& value, size_t size) {
        if (buffSize + size > buffCapacity) resize(buffSize + size);

        auto itInBegin = begin() + pos;
        auto itInEnd = end();
        auto itOut = itInBegin + size;

        std::copy_backward(itInBegin,  itInEnd, itOut);

        while (size--) buffer[buffSize++] = value;
    }

    template<typename Type>
    void Vector<Type>::insert(Iterator pos, const Type& value) {
        insert(pos - begin(), value, 1);
    }

    template<typename Type>
    void Vector<Type>::insert(Iterator pos, const Type& value, size_t size) {
        insert(pos - begin(), value, size);
    }

    template<typename Type>
    void Vector<Type>::erase(size_t pos) {
        erase(pos, 1);
    }

    template<typename Type>
    void Vector<Type>::erase(size_t pos, size_t size) {
        if (size > buffSize) return;

        auto itInBegin = begin() + pos + size;
        auto itInEnt = end();
        auto itOut = begin() + pos;

        std::copy(itInBegin, itInEnt, itOut);
    }

    template<typename Type>
    void Vector<Type>::erase(Iterator pos) {
        erase(pos - begin(), 1);
    }

    template<typename Type>
    void Vector<Type>::erase(Iterator begin, Iterator end) {
        erase(begin - this->begin(), end - begin);
    }

    template<typename Type>
    void Vector<Type>::push_back(const Type& value) {
        insert(end(), value, 1);
    }

    template<typename Type>
    void Vector<Type>::pop_back() {
        buffSize--;
    }

    template<typename Type>
    char* Vector<Type>::data() {
        return buffer.data();
    }

    template<typename Type>
    void Vector<Type>::clear() {
        buffSize = 0;
    }

    template<typename Type>
    typename Vector<Type>::Iterator Vector<Type>::begin() {
        return buffer.get();
    }

    template<typename Type>
    typename Vector<Type>::Iterator Vector<Type>::end() {
        return buffer.get() + buffSize;
    }

    template<typename Type>
    typename Vector<Type>::ReverseIterator Vector<Type>::rbegin() {
        return ReverseIterator{end()};
    }

    template<typename Type>
    typename Vector<Type>::ReverseIterator Vector<Type>::rend() {
        return ReverseIterator{begin()};
    }
}